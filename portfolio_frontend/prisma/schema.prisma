// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  portfolio    Portfolio?
}

model Portfolio {
  id              String           @id @default(uuid())
  userId          String           @unique
  slug            String?          @unique
  bio             String?          @db.Text
  title           String?
  avatarUrl       String?
  contactEmail    String?
  contactPhone    String?
  isPublished     Boolean          @default(false)
  themeId         String           @default("minimal")
  primaryColor    String           @default("#6366f1")
  fontStyle       String           @default("inter")
  layoutVariant   String           @default("single-column")
  viewCount       Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects        Project[]
  skills          Skill[]
  socialLinks     SocialLink[]
  resume          Resume?
  analyticsEvents AnalyticsEvent[]
  certifications  Certification[]
  education       Education[]
  interests       Interest[]
}

model Project {
  id          String   @id @default(uuid())
  portfolioId String
  title       String
  description String?  @db.Text
  imageUrl    String?
  projectUrl  String?
  tags        Json     @default("[]")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
}

model Skill {
  id          String    @id @default(uuid())
  portfolioId String
  name        String
  level       Int       @default(50)
  category    String?
  order       Int       @default(0)
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
}

model SocialLink {
  id          String    @id @default(uuid())
  portfolioId String
  platform    String
  url         String
  order       Int       @default(0)
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
}

model Resume {
  id          String   @id @default(uuid())
  portfolioId String   @unique
  fileName    String
  filePath    String
  uploadedAt  DateTime @default(now())
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
}

model AnalyticsEvent {
  id          String   @id @default(uuid())
  portfolioId String
  eventType   String   @default("page_view")
  createdAt   DateTime @default(now())
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
}

model Certification {
  id          String   @id @default(uuid())
  portfolioId String
  title       String
  issuer      String
  issueDate   String?
  credentialUrl String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
}

model Education {
  id          String   @id @default(uuid())
  portfolioId String
  degree      String
  institution String
  startYear   String?
  endYear     String?
  description String?  @db.Text
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
}

model Interest {
  id          String   @id @default(uuid())
  portfolioId String
  name        String
  description String?  @db.Text
  order       Int      @default(0)
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
}
